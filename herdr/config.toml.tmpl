# @THEME_NAME@ configuration

[theme]
name = "@HERDR_THEME@"
auto_switch = false

[ui]
window_title = "🐐"

[terminal]
default_shell = "/bin/zsh"
shell_mode = "login"
new_cwd = "follow"

[keys]
# Prefix assignments follow docs/shortcuts.md; Ctrl+Alt alternatives avoid Ghostty Cmd keys.
new_tab = ["prefix+t", "ctrl+alt+t"]
close_tab = "prefix+shift+t"
rename_tab = "prefix+shift+e"
previous_tab = ["prefix+p", "ctrl+alt+p"]
next_tab = ["prefix+n", "ctrl+alt+n"]
switch_tab = "prefix+1..9"
focus_pane_left = ["prefix+h", "ctrl+alt+h"]
focus_pane_down = ["prefix+j", "ctrl+alt+j"]
focus_pane_up = ["prefix+k", "ctrl+alt+k"]
focus_pane_right = ["prefix+l", "ctrl+alt+l"]
split_vertical = ["prefix+d", "ctrl+alt+d"]
split_horizontal = ["prefix+shift+d", "ctrl+alt+shift+d"]
zoom = ["prefix+z", "ctrl+alt+z"]
close_pane = "prefix+x"
rename_pane = "prefix+shift+x"
workspace_picker = "prefix+shift+p"
new_workspace = "prefix+w"
close_workspace = "prefix+shift+w"
rename_workspace = "prefix+shift+a"
detach = "prefix+q"
